{
  "name": "@askrjs/askr",
  "version": "0.0.29",
  "description": "Actor-backed deterministic UI framework",
  "keywords": [
    "askr",
    "framework",
    "jsx",
    "ssr",
    "ui"
  ],
  "homepage": "https://github.com/askrjs/askr#readme",
  "bugs": {
    "url": "https://github.com/askrjs/askr/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "askrjs",
    "url": "https://github.com/askrjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/askrjs/askr.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./boot": {
      "import": "./dist/boot/index.js",
      "types": "./dist/boot/index.d.ts"
    },
    "./control": {
      "import": "./dist/control/index.js",
      "types": "./dist/control/index.d.ts"
    },
    "./foundations": {
      "import": "./dist/foundations/index.js",
      "types": "./dist/foundations/index.d.ts"
    },
    "./resources": {
      "import": "./dist/resources/index.js",
      "types": "./dist/resources/index.d.ts"
    },
    "./fx": {
      "import": "./dist/fx/index.js",
      "types": "./dist/fx/index.d.ts"
    },
    "./router": {
      "import": "./dist/router/index.js",
      "types": "./dist/router/index.d.ts"
    },
    "./ssr": {
      "import": "./dist/ssr/index.js",
      "types": "./dist/ssr/index.d.ts"
    },
    "./ssg": {
      "import": "./dist/ssg/index.js",
      "types": "./dist/ssg/index.d.ts"
    },
    "./jsx-runtime": {
      "import": "./dist/jsx-runtime.js",
      "types": "./dist/jsx-runtime.d.ts"
    },
    "./jsx-dev-runtime": {
      "import": "./dist/jsx-dev-runtime.js",
      "types": "./dist/jsx-dev-runtime.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production vp pack",
    "pack": "npm run build",
    "build:dev": "cross-env NODE_ENV=development vp pack",
    "build:bench": "cross-env BUILD=bench NODE_ENV=production vp build",
    "dev": "vp dev",
    "dev:watch": "cross-env NODE_ENV=development vp pack --watch",
    "prepare": "npm run build",
    "test": "node scripts/run-all-tests.js",
    "test:unit": "vp test run -c vitest.unit.config.ts",
    "test:jsdom": "vp test run -c vitest.jsdom.config.ts",
    "test:docs": "vp test run checks/docs/public-api-imports.test.ts",
    "test:examples": "vp test run checks/examples/ssg-config.test.ts",
    "test:types": "npm run build && tsd",
    "test:browser": "playwright test tests/playwright/e2e --project=chromium",
    "test:a11y": "playwright test tests/playwright/a11y --project=chromium-a11y",
    "test:browser:smoke": "playwright test tests/playwright/e2e --project=chromium --project=firefox --project=webkit --grep @smoke",
    "test:browser:install": "playwright install chromium firefox webkit",
    "verify:monorepo": "node scripts/validate-monorepo.js",
    "verify:release": "npm run lint && npm run build && npm test && npm run test:docs && npm run test:examples && npm run perf:size",
    "bench": "npm run bench:micro && npm run bench:jsdom && npm run bench:ssr",
    "bench:micro:base": "cross-env NODE_ENV=production vp test bench -c vitest.bench.micro.config.ts",
    "bench:dom:base": "cross-env NODE_ENV=production vp test bench -c vitest.bench.dom.config.ts",
    "bench:dom:tier3:base": "cross-env NODE_ENV=production vp test bench -c vitest.bench.dom.tier3.config.ts",
    "bench:dom:tier4:base": "cross-env NODE_ENV=production vp test bench -c vitest.bench.dom.tier4.config.ts",
    "bench:jsdom:base": "npm run bench:dom:base",
    "bench:ssr:base": "cross-env NODE_ENV=production vp test bench -c vitest.bench.ssr.config.ts",
    "bench:micro": "npm run bench:micro:base -- --run",
    "bench:dom": "npm run bench:dom:base -- --run",
    "bench:jsdom": "npm run bench:dom",
    "bench:ssr": "npm run bench:ssr:base -- --run",
    "bench:browser": "playwright test benches/browser --project=browser-perf",
    "bench:watch": "npm run bench:dom:base -- --watch",
    "bench:watch:ssr": "npm run bench:ssr:base -- --watch",
    "bench:tier1": "npm run bench:micro:base -- benches/micro/tier1/ --run && npm run bench:dom:base -- benches/jsdom/tier1/ --run && npm run bench:ssr:base -- benches/ssr/tier1/ --run",
    "bench:tier2": "npm run bench:dom:base -- benches/jsdom/tier2/ --run && npm run bench:ssr:base -- benches/ssr/tier2/ --run",
    "bench:tier3": "npm run bench:dom:tier3:base -- --run",
    "bench:tier4": "npm run bench:dom:tier4:base -- --run",
    "bench:json": "node -e \"const fs=require('node:fs'); fs.rmSync('bench-results',{recursive:true,force:true}); fs.mkdirSync('bench-results',{recursive:true});\" && npm run bench:micro:base -- --run --outputJson bench-results/micro.json && npm run bench:dom:base -- --run --outputJson bench-results/jsdom.json && npm run bench:ssr:base -- --run --outputJson bench-results/ssr.json && node scripts/generate-bench-log.js",
    "bench:verify": "npm run bench:json && node scripts/generate-bench-log.js --verify",
    "bench:baseline": "node scripts/capture-bench-baseline.js",
    "bench:baseline:quick": "node scripts/capture-bench-baseline.js --runs=2",
    "bench:compare": "node scripts/compare-bench-snapshots.js",
    "perf:scenarios": "node scripts/run-perf-scenarios.js",
    "perf:loop": "node scripts/run-perf-loop.js --runs=2",
    "perf:phase0": "node scripts/run-perf-loop.js --runs=3",
    "prepublishOnly": "npm run pack",
    "fmt": "vp fmt .",
    "lint": "cross-env OXLINT_TSGOLINT_PATH=./node_modules/.bin/tsgolint.cmd vp lint src tests test-utils checks benches"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.0",
    "playwright": "^1.59.1",
    "tsd": "^0.33.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.19"
  },
  "engines": {
    "node": ">=18"
  }
}
