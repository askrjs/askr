{
  "name": "@askrjs/askr",
  "version": "0.0.36",
  "description": "Actor-backed deterministic UI framework",
  "keywords": [
    "askr",
    "framework",
    "jsx",
    "ssr",
    "ui"
  ],
  "homepage": "https://github.com/askrjs/askr#readme",
  "bugs": {
    "url": "https://github.com/askrjs/askr/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "askrjs",
    "url": "https://github.com/askrjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/askrjs/askr.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./boot": {
      "import": "./dist/boot/index.js",
      "types": "./dist/boot/index.d.ts"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./control": {
      "import": "./dist/control/index.js",
      "types": "./dist/control/index.d.ts"
    },
    "./foundations": {
      "import": "./dist/foundations/index.js",
      "types": "./dist/foundations/index.d.ts"
    },
    "./resources": {
      "import": "./dist/resources/index.js",
      "types": "./dist/resources/index.d.ts"
    },
    "./data": {
      "import": "./dist/data/index.js",
      "types": "./dist/data/index.d.ts"
    },
    "./fx": {
      "import": "./dist/fx/index.js",
      "types": "./dist/fx/index.d.ts"
    },
    "./router": {
      "import": "./dist/router/index.js",
      "types": "./dist/router/index.d.ts"
    },
    "./ssr": {
      "import": "./dist/ssr/index.js",
      "types": "./dist/ssr/index.d.ts"
    },
    "./ssg": {
      "import": "./dist/ssg/index.js",
      "types": "./dist/ssg/index.d.ts"
    },
    "./jsx-runtime": {
      "import": "./dist/jsx-runtime.js",
      "types": "./dist/jsx-runtime.d.ts"
    },
    "./jsx-dev-runtime": {
      "import": "./dist/jsx-dev-runtime.js",
      "types": "./dist/jsx-dev-runtime.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp dev",
    "fmt": "vp fmt .",
    "lint": "vp lint src tests test-utils checks benches",
    "test": "npm run test:unit && npm run test:jsdom && npm run test:browser",
    "test:browser": "vp test run -c vitest.browser.config.ts tests/browser",
    "test:jsdom": "vp test run -c vitest.jsdom.config.ts",
    "test:types": "vp pack && tsd",
    "test:unit": "vp test run -c vitest.unit.config.ts",
    "bench": "npm run bench:tier1 && npm run bench:tier2 && npm run bench:tier3 && npm run bench:tier4",
    "bench:tier1": "cross-env NODE_ENV=production vp test bench --run --reporter=default --config vitest.tier1.bench.config.ts",
    "bench:tier2": "cross-env NODE_ENV=production vp test bench --run --reporter=default --config vitest.tier2.bench.config.ts",
    "bench:tier3": "cross-env NODE_ENV=production vp test bench --run --reporter=default --config vitest.tier3.bench.config.ts",
    "bench:tier4": "cross-env NODE_ENV=production vp test bench --run --reporter=default --config vitest.tier4.bench.config.ts"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "tsd": "^0.33.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.21"
  },
  "engines": {
    "node": ">=18"
  }
}
