{
  "name": "{{appName}}",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test run",
    "test:watch": "vp test --watch",
    "type-check": "tsc --noEmit",
    "lint": "cross-env OXLINT_TSGOLINT_PATH=../../../../node_modules/.bin/tsgolint.cmd vp lint .",
    "lint:fix": "cross-env OXLINT_TSGOLINT_PATH=../../../../node_modules/.bin/tsgolint.cmd vp lint --fix .",
    "fmt": "vp fmt .",
    "fmt:check": "vp fmt --check .",
    "check": "cross-env OXLINT_TSGOLINT_PATH=../../../../node_modules/.bin/tsgolint.cmd vp check && vp test run"
  },
  "dependencies": {
    "@askrjs/askr": ">=0.0.28 <1.0.0",
    "@askrjs/askr-ui": "^1.0.0",
    "@askrjs/askr-themes": "^0.1.0",
    "@askrjs/askr-lucide": "^0.0.1"
  },
  "devDependencies": {
    "@askrjs/askr-vite": "^0.1.0",
    "@types/node": "^25.0.9",
    "jiti": "^2.6.1",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vite-plus": "latest"
  }
}
