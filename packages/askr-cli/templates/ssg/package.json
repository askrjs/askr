{
  "name": "{{appName}}",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "generate": "tsx ssg-build.ts",
    "preview": "vp preview",
    "test": "vp test run",
    "type-check": "tsc --noEmit",
    "lint": "cross-env OXLINT_TSGOLINT_PATH=../../../../node_modules/.bin/tsgolint.cmd vp lint src tests",
    "lint:fix": "cross-env OXLINT_TSGOLINT_PATH=../../../../node_modules/.bin/tsgolint.cmd vp lint --fix src tests",
    "fmt": "vp fmt \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.md\""
  },
  "dependencies": {
    "@askrjs/askr": ">=0.0.28 <1.0.0",
    "@askrjs/askr-ui": "^1.0.0",
    "@askrjs/askr-themes": "^0.1.0"
  },
  "devDependencies": {
    "@askrjs/askr-vite": "^0.1.0",
    "@types/node": "^25.0.9",
    "jiti": "^2.6.1",
    "jsdom": "^27.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-plus": "latest"
  }
}
