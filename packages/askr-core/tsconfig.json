{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "lib": ["ES2021", "DOM"],

    "jsx": "preserve",
    "jsxImportSource": "@askrjs/askr",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@askrjs/askr": ["./src/index.ts"],
      "@askrjs/askr/boot": ["./src/boot/index.ts"],
      "@askrjs/askr/for": ["./src/for/index.ts"],
      "@askrjs/askr/foundations": ["./src/foundations/index.ts"],
      "@askrjs/askr/resources": ["./src/resources/index.ts"],
      "@askrjs/askr/fx": ["./src/fx/index.ts"],
      "@askrjs/askr/router": ["./src/router/index.ts"],
      "@askrjs/askr/ssr": ["./src/ssr/index.ts"],
      "@askrjs/askr/ssg": ["./src/ssg/index.ts"],
      "@askrjs/askr/jsx-runtime": ["./src/jsx-runtime.ts"],
      "@askrjs/askr/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"]
    },

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "moduleResolution": "bundler"
  },

  "include": ["src/**/*"],
  "exclude": ["tests", "benches", "examples"]
}
