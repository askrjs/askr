{
  "version": 1,
  "package": "@askrjs/askr",
  "capabilities": [
    {
      "intent": "reactive state and derived views",
      "package": "@askrjs/askr",
      "import": "@askrjs/askr",
      "exports": ["state", "derive", "selector", "For"],
      "constraints": ["component render scope", "stable call order"],
      "stability": "stable",
      "docs": "https://github.com/askrjs/askr/blob/main/docs/core/reactivity.md"
    },
    {
      "intent": "routing and navigation",
      "package": "@askrjs/askr",
      "import": "@askrjs/askr/router",
      "exports": ["route", "Link", "navigate", "createRouteRegistry"],
      "constraints": ["route registry owns navigation"],
      "stability": "stable",
      "docs": "https://github.com/askrjs/askr/blob/main/docs/guides/router.md"
    },
    {
      "intent": "server rendering and static generation",
      "package": "@askrjs/askr",
      "import": "@askrjs/askr/ssr",
      "exports": ["renderToString", "createStaticGen"],
      "constraints": ["browser globals require lazy client targets"],
      "stability": "stable",
      "docs": "https://github.com/askrjs/askr/blob/main/docs/guides/ssg.md"
    },
    {
      "intent": "error boundaries and portals",
      "package": "@askrjs/askr",
      "import": "@askrjs/askr/components",
      "exports": ["ErrorBoundary", "Portal", "DefaultPortal"],
      "constraints": ["portal hosts are finalized during render"],
      "stability": "stable",
      "docs": "https://github.com/askrjs/askr/blob/main/docs/reference/api.md"
    }
  ]
}
